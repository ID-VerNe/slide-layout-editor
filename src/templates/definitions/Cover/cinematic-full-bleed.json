{
  "id": "cinematic-full-bleed",
  "name": "Cinematic Bleed",
  "category": "Cover",
  "desc": "Full-screen cinematic cover.",
  "tags": [
    "Cinematic",
    "Impact"
  ],
  "supportedRatios": [
    "16:9",
    "2:3"
  ],
  "fields": [
    {
      "key": "variant",
      "label": "Layout Orientation",
      "type": "switcher",
      "props": {
        "mode": "top-bottom",
        "options": [
          {
            "value": "bottom",
            "label": "Headline Bottom",
            "icon": "ArrowDown"
          },
          {
            "value": "top",
            "label": "Headline Top",
            "icon": "ArrowUp"
          }
        ]
      }
    },
    {
      "key": "titleY",
      "label": "Headline Position"
    },
    {
      "key": "title",
      "label": "Headline"
    },
    {
      "key": "subtitle",
      "label": "Subtitle"
    },
    {
      "key": "image",
      "label": "Background Image"
    },
    {
      "key": "imageLabel",
      "label": "Copyright Text"
    }
  ],
  "root": {
    "type": "Container",
    "layout": "modular",
    "layoutProps": {
      "columns": 24,
      "rows": 24,
      "gap": "spacing.none"
    },
    "className": "w-full h-full relative p-0 overflow-hidden bg-zine-primary",
    "children": [
      {
        "type": "Container",
        "layout": "absolute",
        "layoutProps": {
          "inset": 0
        },
        "children": [
          {
            "type": "Component",
            "componentType": "ZineMedia",
            "props": {
              "className": "w-full h-full object-cover"
            }
          }
        ]
      },
      {
        "type": "Conditional",
        "condition": "{page.layoutVariant === \"top\"}",
        "then": {
          "type": "Container",
          "layout": "modular",
          "layoutProps": {
            "columns": 24,
            "rows": 24
          },
          "className": "absolute inset-0 pointer-events-none",
          "children": [
            {
              "type": "Container",
              "layout": "flex",
              "layoutProps": {
                "direction": "column",
                "align": "center",
                "justify": "start"
              },
              "modular": {
                "colStart": 1,
                "colSpan": 24,
                "rowStart": 4,
                "rowSpan": 3
              },
              "className": "pt-8",
              "children": [
                {
                  "type": "Component",
                  "componentType": "ZineDisplay",
                  "bind": "page.title",
                  "props": {
                    "italic": true,
                    "tracking": 0.4,
                    "align": "center",
                    "serif": true,
                    "className": "drop-shadow-2xl",
                    "color": "surface"
                  }
                }
              ]
            },
            {
              "type": "Container",
              "layout": "flex",
              "layoutProps": {
                "direction": "column",
                "align": "center",
                "justify": "center"
              },
              "modular": {
                "colStart": 1,
                "colSpan": 24,
                "rowStart": 19,
                "rowSpan": 1
              },
              "children": [
                {
                  "type": "Component",
                  "componentType": "ZineCaption",
                  "bind": "page.subtitle",
                  "props": {
                    "align": "center",
                    "tracking": 0.5,
                    "sans": true,
                    "bold": true,
                    "className": "uppercase opacity-80",
                    "color": "surface"
                  }
                }
              ]
            }
          ]
        },
        "else": {
          "type": "Container",
          "layout": "modular",
          "layoutProps": {
            "columns": 24,
            "rows": 24
          },
          "className": "absolute inset-0 pointer-events-none",
          "children": [
            {
              "type": "Container",
              "layout": "flex",
              "layoutProps": {
                "direction": "column",
                "align": "center",
                "justify": "center"
              },
              "modular": {
                "colStart": 1,
                "colSpan": 24,
                "rowStart": 18,
                "rowSpan": 1
              },
              "children": [
                {
                  "type": "Component",
                  "componentType": "ZineCaption",
                  "bind": "page.subtitle",
                  "props": {
                    "align": "center",
                    "tracking": 0.6,
                    "bold": true,
                    "sans": true,
                    "className": "uppercase",
                    "color": "surface"
                  }
                }
              ]
            },
            {
              "type": "Container",
              "layout": "flex",
              "layoutProps": {
                "direction": "column",
                "align": "center",
                "justify": "end"
              },
              "modular": {
                "colStart": 1,
                "colSpan": 24,
                "rowStart": 19,
                "rowSpan": 2
              },
              "className": "pb-8",
              "children": [
                {
                  "type": "Component",
                  "componentType": "ZineDisplay",
                  "bind": "page.title",
                  "props": {
                    "italic": true,
                    "tracking": 0.3,
                    "align": "center",
                    "serif": true,
                    "className": "drop-shadow-2xl",
                    "color": "surface"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "type": "Container",
        "layout": "flex",
        "layoutProps": {
          "direction": "row",
          "align": "center",
          "justify": "center"
        },
        "modular": {
          "colStart": 1,
          "colSpan": 24,
          "rowStart": 21,
          "rowSpan": 1
        },
        "style": {
          "position": "relative",
          "zIndex": 10
        },
        "children": [
          {
            "type": "Component",
            "componentType": "ZineBody",
            "bind": "page.imageLabel",
            "props": {
              "align": "center",
              "sans": true,
              "size": 0.9,
              "italic": true,
              "tracking": 0.2,
              "color": "surface",
              "className": "opacity-60"
            }
          }
        ]
      }
    ]
  }
}