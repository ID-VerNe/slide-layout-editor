{
  "id": "zine-classic",
  "name": "Zine Classic",
  "category": "Gallery",
  "desc": "The definitive 24x24 modular grid template. Industrial precision.",
  "tags": [
    "Zine",
    "Modular",
    "Precision"
  ],
  "supportedRatios": [
    "16:9",
    "2:3",
    "A4"
  ],
  "fields": [
    {
      "key": "title",
      "label": "Headline"
    },
    {
      "key": "subtitle",
      "label": "Sub-Headline"
    },
    {
      "key": "paragraph",
      "label": "Body Copy"
    },
    {
      "key": "image",
      "label": "Main Media"
    },
    {
      "key": "imageLabel",
      "label": "Meta Info"
    }
  ],
  "root": {
    "type": "Container",
    "layout": "modular",
    "layoutProps": {
      "columns": 24,
      "rows": 24,
      "gap": "spacing.none"
    },
    "className": "w-full h-full relative p-0",
    "children": [
      {
        "type": "Container",
        "layout": "absolute",
        "modular": {
          "colStart": 1,
          "colSpan": 12,
          "rowStart": 1,
          "rowSpan": 24
        },
        "className": "bg-zine-surface/20 border-r border-zine-accent/5",
        "children": []
      },
      {
        "type": "Component",
        "componentType": "ZineDisplay",
        "modular": {
          "colStart": 2,
          "colSpan": 10,
          "rowStart": 3,
          "rowSpan": 5
        },
        "bind": "page.title",
        "props": {
          "color": "primary"
        }
      },
      {
        "type": "Container",
        "layout": "absolute",
        "modular": {
          "colStart": 2,
          "colSpan": 3,
          "rowStart": 8,
          "rowSpan": 1
        },
        "className": "border-t-2 border-zine-accent mt-2",
        "children": []
      },
      {
        "type": "Component",
        "componentType": "ZineCaption",
        "bind": "page.subtitle",
        "modular": {
          "colStart": 2,
          "colSpan": 10,
          "rowStart": 9,
          "rowSpan": 1
        },
        "props": {
          "color": "accent"
        }
      },
      {
        "type": "Component",
        "componentType": "ZineBody",
        "modular": {
          "colStart": 2,
          "colSpan": 9,
          "rowStart": 11,
          "rowSpan": 9
        },
        "bind": "page.paragraph",
        "props": {
          "color": "secondary"
        }
      },
      {
        "type": "Component",
        "componentType": "ZineMedia",
        "modular": {
          "colStart": 13,
          "colSpan": 11,
          "rowStart": 2,
          "rowSpan": 21
        },
        "props": {
          "className": "shadow-2xl z-20",
          "imgClassName": "hover:scale-105 transition-transform duration-1000"
        }
      },
      {
        "type": "Component",
        "componentType": "ZineCaption",
        "bind": "page.imageLabel",
        "modular": {
          "colStart": 13,
          "colSpan": 11,
          "rowStart": 21,
          "rowSpan": 1
        },
        "props": {
          "className": "text-right opacity-30",
          "color": "secondary"
        }
      }
    ]
  }
}